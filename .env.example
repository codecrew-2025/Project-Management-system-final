# Frontend URL used to build reset links
# Use your local machine IP for phone access, e.g. http://192.168.1.42:5173
# Or use ngrok to expose the frontend publicly and set FRONTEND_URL to that URL.
FRONTEND_URL=http://localhost:5173
# NGROK_URL=https://xxxxxx.ngrok.app
# NGROK_AUTHTOKEN=your-ngrok-auth-token

# Backend port
PORT=3001

# SMTP settings (optional) - if set, reset emails will be sent
# Example using SMTP relay or service provider credentials
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=ProjectFlow <no-reply@example.com>

# MongoDB connection (already configured in your existing .env)
# MONGO_URL=mongodb://localhost:27017/projectflow

# Backend URL for production (set this in Vercel environment variables)
# VITE_API_URL=https://your-backend.onrender.com/api

# Backend URL for production (set this in Vercel environment variables)
# VITE_API_URL=https://your-backend.onrender.com/api
